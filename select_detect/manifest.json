{
  "manifest_version": 3,
  "name": "Real-Time Screen Scanner & OCR Engine",
  "version": "1.1.0",
  "description": "High-performance real-time screen scanner with low-latency change detection, sub-ROI OCR, producer-consumer strategy, and draggable Pop Up Remote overlay.",
  "permissions": [
    "desktopCapture",
    "tabCapture",
    "activeTab",
    "tabs",
    "storage",
    "offscreen",
    "scripting"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "index.html",
        "remote.html",
        "remote.js",
        "dashboard.css",
        "dashboard.js",
        "content.css",
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
